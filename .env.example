# MySQL on Hostinger. Create the database and user in hPanel -> Databases,
# then paste the connection string here.
DATABASE_URL="mysql://USERNAME:PASSWORD@srv1001.hstgr.io:3306/DATABASE_NAME"

# Signs the admin session cookie. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_VALUE"

NODE_ENV="development"

# The first admin account, created by `npm run db:seed`.
ADMIN_NAME="Manbayee Admin"
ADMIN_EMAIL="admin@manbayee.com"
ADMIN_PASSWORD="change-this-password"

# Where uploaded thumbnails are written. Keep it outside the build output so a
# redeploy does not delete them. Defaults to ./uploads
UPLOAD_DIR=""
